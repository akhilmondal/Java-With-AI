{
    // The Java lessons are plain single-file programs (no Maven or Gradle).
    // Listing their folders here gives full code help and a Run button in VS Code.
    // All three folders share one default package, so every class name must be unique
    // (the J01_, S01_, D01_ prefixes take care of that).
    "java.project.sourcePaths": [
        "01-java-core",
        "02-java8-streams",
        "04-dsa"
    ],

    // Accept both US and British spellings (behaviour, colour, tyre).
    "cSpell.language": "en,en-GB",

